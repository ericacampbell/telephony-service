# Stage 1 — pipeline only. Twilio/Supabase vars land in stages 3-6.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Pin in any deployed environment. Tenants are in memory until stage 3, so an
# unpinned token is regenerated on every restart and shared links break.
SHARE_TOKEN=

# Optional overrides
STT_MODEL=whisper-large-v3-turbo
BRIEF_MODEL=claude-sonnet-4-6
BRIEF_EFFORT=medium
DEFAULT_TENANT_SLUG=demo
PORT=3000
